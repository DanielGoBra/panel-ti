# Copia este archivo como .env y ajusta los valores. Todos son opcionales salvo SECRET_KEY en producción.

# --- Servidor ---
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
HOST=0.0.0.0
PORT=8000
# Detrás de un proxy con HTTPS (Caddy, Nginx, IIS):
TRUST_PROXY=1
COOKIE_SECURE=1
PUBLIC_URL=https://panel-ti.empresa.com

# --- Datos ---
# PANEL_TI_DB=/datos/panel-ti/data.db
# PANEL_TI_UPLOADS=/datos/panel-ti/uploads
# PANEL_TI_BACKUP_DIR=/datos/panel-ti/backups
PANEL_TI_BACKUP_HOURS=24
PANEL_TI_BACKUP_KEEP=14
# Arrancar sin datos de demostración:
PANEL_TI_NO_SEED=1

# --- Microsoft Entra ID (inicio de sesión con la cuenta de la empresa) ---
# MS_TENANT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_SECRET=...
# MS_REDIRECT_URI=https://panel-ti.empresa.com/auth/microsoft/callback
# MS_DEFAULT_ROLE=member      # rol de las cuentas que se crean al entrar por primera vez
# MS_AUTO_PROVISION=1         # 0 = solo pueden entrar personas dadas de alta antes

# --- Correo saliente (avisos) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=panel-ti@empresa.com
# SMTP_PASSWORD=...
# SMTP_FROM=Panel TI <panel-ti@empresa.com>

# --- Buzón de entrada (correo -> tarea) ---
# IMAP_HOST=outlook.office365.com
# IMAP_USER=soporte@empresa.com
# IMAP_PASSWORD=...
# IMAP_FOLDER=INBOX

# --- IA (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# PANEL_TI_AI_MODEL=claude-opus-5-5
